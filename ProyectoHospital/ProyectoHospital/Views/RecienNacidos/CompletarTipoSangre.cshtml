@model ProyectoHospital.Models.ViewModels.CompletarTipoSangreRecienNacidoViewModel

@{
    ViewData["Title"] = "Completar tipificación sanguínea";
}

<div class="container mt-4 mb-5">
    <h2>Completar tipo sanguíneo</h2>
    <p>Paciente #@Model.PacienteId — @ViewData["NombreBebe"]</p>
    <div class="alert alert-warning">
        Actualmente figura como <strong>pendiente de tipificación (ND)</strong>.
        Registre un resultado únicamente si está respaldado por un informe de laboratorio.
        Este formulario no reemplaza la valoración clínica.
    </div>

    <form asp-controller="RecienNacidos" asp-action="CompletarTipoSangre"
          method="post" asp-antiforgery="true" class="card shadow-sm">
        <div class="card-body p-4">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input asp-for="PacienteId" type="hidden" />

            <div class="mb-3">
                <label asp-for="TipoSangre" class="form-label">Grupo sanguíneo confirmado</label>
                <select asp-for="TipoSangre" class="form-select">
                    <option value="">Seleccione...</option>
                    <option value="O+">O+</option>
                    <option value="O-">O-</option>
                    <option value="A+">A+</option>
                    <option value="A-">A-</option>
                    <option value="B+">B+</option>
                    <option value="B-">B-</option>
                    <option value="AB+">AB+</option>
                    <option value="AB-">AB-</option>
                    <option value="RHN">Rh nulo (confirmado)</option>
                </select>
                <span asp-validation-for="TipoSangre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ReferenciaLaboratorio" class="form-label">
                    Referencia del informe de laboratorio
                </label>
                <input asp-for="ReferenciaLaboratorio" maxlength="200"
                       class="form-control" autocomplete="off"
                       placeholder="Código interno del informe, sin datos sensibles" />
                <span asp-validation-for="ReferenciaLaboratorio" class="text-danger"></span>
                <div class="form-text">
                    La referencia se registrará en la auditoría junto con el usuario responsable.
                    No introduzca resultados clínicos completos ni información personal en este campo.
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">Confirmar tipificación</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
