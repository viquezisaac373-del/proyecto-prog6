@model ProyectoHospital.Models.ViewModels.EditarRecienNacidoViewModel

@{
    ViewData["Title"] = "Editar nacimiento";
}

<div class="container mt-4 mb-5">
    <h2>Editar nacimiento #@Model.NacimientoId</h2>
    <p class="text-muted">
        Paciente #@Model.PacienteId. Se conservan identificación, género, fecha y
        hora de nacimiento, tipo sanguíneo, madre y médico. Las correcciones
        excepcionales de estos datos deben autorizarse y auditarse por separado.
    </p>
    <div class="alert alert-info">
        Esta edición modifica datos administrativos del bebé y detalles del nacimiento.
        Los cambios quedarán auditados. No modifica el expediente de la madre ni del médico.
    </div>

    <form id="formRN" asp-controller="RecienNacidos" asp-action="Editar"
          asp-route-id="@Model.NacimientoId" method="post"
          asp-antiforgery="true" class="card shadow-sm">
        <div class="card-body p-4">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div id="mensajeTelefonosRN" class="alert alert-warning d-none" role="alert"></div>
            <input asp-for="NacimientoId" type="hidden" />
            <input asp-for="PacienteId" type="hidden" />
            <input asp-for="MadrePacienteId" type="hidden" />
            <input asp-for="EmpleadoId" type="hidden" />

            <p class="text-muted small">
                Madre — paciente #@Model.MadrePacienteId ·
                Médico responsable — empleado #@Model.EmpleadoId.
                Para modificar estas relaciones se requiere un proceso administrativo distinto.
            </p>

            <h5 class="mb-3">Datos del bebé</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Nombre" class="form-label">Nombre</label>
                    <input asp-for="Nombre" maxlength="100" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Apellidos" class="form-label">Apellidos</label>
                    <input asp-for="Apellidos" maxlength="130" class="form-control" />
                    <span asp-validation-for="Apellidos" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Genero" class="form-label">Sexo registrado al nacer</label>
                    <input type="text" class="form-control" readonly
                           value="@(Model.Genero == "Indeterminado"
                               ? "Indeterminado (pendiente de valoración clínica)"
                               : Model.Genero == "Otro"
                                   ? "Otro (dato histórico; requiere revisión)"
                                   : Model.Genero)" />
                    <input asp-for="Genero" type="hidden" />
                    <span asp-validation-for="Genero" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FechaHoraNacimiento" class="form-label">Fecha y hora del nacimiento</label>
                    <input type="text" class="form-control" readonly
                           value="@(Model.FechaHoraNacimiento?.ToString("yyyy-MM-dd HH:mm"))" />
                    <input asp-for="FechaHoraNacimiento" type="hidden" />
                    <span asp-validation-for="FechaHoraNacimiento" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TipoParto" class="form-label">Tipo de parto</label>
                    <select asp-for="TipoParto" class="form-select">
                        <option value="Vaginal">Vaginal</option>
                        <option value="Cesarea">Cesárea</option>
                    </select>
                    <span asp-validation-for="TipoParto" class="text-danger"></span>
                </div>
            </div>

            <hr class="my-4" />
            <h5 class="mb-3">Datos de contacto</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="NumeroTelefono" class="form-label">Teléfono</label>
                    <input id="telefonoVisibleRN" type="tel" class="form-control"
                           inputmode="tel" autocomplete="tel" required />
                    <input asp-for="NumeroTelefono" type="hidden" />
                    <div id="errorTelefonoRN" class="text-danger small mt-1" aria-live="polite"></div>
                    <span asp-validation-for="NumeroTelefono" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Direccion" class="form-label">Dirección</label>
                    <input asp-for="Direccion" maxlength="250" class="form-control" />
                    <span asp-validation-for="Direccion" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ContactoEmergencia" class="form-label">Contacto de emergencia</label>
                    <input asp-for="ContactoEmergencia" maxlength="100" class="form-control" />
                    <span asp-validation-for="ContactoEmergencia" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TelefonoEmergencia" class="form-label">Teléfono de emergencia</label>
                    <input id="emergenciaVisibleRN" type="tel" class="form-control"
                           inputmode="tel" required />
                    <input asp-for="TelefonoEmergencia" type="hidden" />
                    <div id="errorEmergenciaRN" class="text-danger small mt-1" aria-live="polite"></div>
                    <span asp-validation-for="TelefonoEmergencia" class="text-danger"></span>
                </div>
            </div>

            <hr class="my-4" />
            <h5 class="mb-3">Datos clínicos del nacimiento</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="SemanasGestacion" class="form-label">Semanas de gestación</label>
                    <input asp-for="SemanasGestacion" type="number" min="1" max="255" class="form-control" />
                    <span asp-validation-for="SemanasGestacion" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="PesoEnGramos" class="form-label">Peso (gramos)</label>
                    <input asp-for="PesoEnGramos" type="number" min="1" class="form-control" />
                    <span asp-validation-for="PesoEnGramos" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="TallaCentimetros" class="form-label">Talla (cm)</label>
                    <input asp-for="TallaCentimetros" type="number" step="0.01" min="0.01"
                           max="9999.99" class="form-control" />
                    <span asp-validation-for="TallaCentimetros" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Apgar1Min" class="form-label">Apgar al minuto</label>
                    <input asp-for="Apgar1Min" type="number" min="0" max="10" class="form-control" />
                    <span asp-validation-for="Apgar1Min" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Apgar5Min" class="form-label">Apgar a los 5 minutos</label>
                    <input asp-for="Apgar5Min" type="number" min="0" max="10" class="form-control" />
                    <span asp-validation-for="Apgar5Min" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Respiracion" class="form-label">Respiración</label>
                    <input asp-for="Respiracion" maxlength="100" class="form-control" />
                    <span asp-validation-for="Respiracion" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="EstadoSalud" class="form-label">Estado de salud</label>
                    <input asp-for="EstadoSalud" maxlength="150" class="form-control" />
                    <span asp-validation-for="EstadoSalud" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Malformaciones" class="form-label">Hallazgos observados</label>
                    <textarea asp-for="Malformaciones" maxlength="400" rows="2" class="form-control"></textarea>
                    <span asp-validation-for="Malformaciones" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="ObservacionesMedicas" class="form-label">Observaciones médicas</label>
                    <textarea asp-for="ObservacionesMedicas" maxlength="500" rows="3" class="form-control"></textarea>
                    <span asp-validation-for="ObservacionesMedicas" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button id="btnGuardarRN" type="submit" class="btn btn-primary"
                        data-permitido="true" disabled>Guardar cambios</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_TelefonosRecienNacidos" />
}
