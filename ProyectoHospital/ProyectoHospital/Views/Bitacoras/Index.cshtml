@model BitacoraIndexViewModel
@using ProyectoHospital.Models.Enums
@{
    ViewData["Title"] = "Bitácoras del sistema";
    var tipos = Enum.GetValues<TipoBitacora>();
}

<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
        <div>
            <h2>Bitácoras del sistema</h2>
            <p class="text-muted mb-0">Consulta de los eventos registrados en Hospinomenal. Solo lectura.</p>
        </div>
        <a class="btn btn-primary" href="@(Context.Request.Path + Context.Request.QueryString)">Actualizar</a>
    </div>

    <ul class="nav nav-tabs bitacoras-tabs" role="tablist">
        @foreach (var tipo in tipos)
        {
            <li class="nav-item" role="presentation">
                <a class="nav-link @(tipo == Model.Tipo ? "active" : "")"
                   aria-current="@(tipo == Model.Tipo ? "page" : null)"
                   asp-action="Index" asp-route-tipo="@tipo">
                    @BitacoraIndexViewModel.NombreBitacora(tipo)
                </a>
            </li>
        }
    </ul>

    @if (Model.Tipo == TipoBitacora.Notificaciones)
    {
        <p class="small text-muted mt-2 mb-2">
            Los avisos de recién nacidos identificados como «Interna (sin envío)»
            son registros dentro del sistema: no implican correo ni SMS.
            Los avisos históricos no se eliminan cuando se completa el trámite.
        </p>
    }

    <div class="card shadow-sm bitacoras-card">
        <form method="get" asp-action="Index" class="bitacoras-filtros border-bottom p-3">
            <input type="hidden" name="tipo" value="@Model.Tipo" />
            <input type="hidden" name="orden" value="@Model.Filtro.Orden" />
            <input type="hidden" name="dir" value="@(Model.Filtro.Descendente ? "desc" : "asc")" />
            <div class="row g-2 align-items-end">
                <div class="col-6 col-md-3 col-lg-2">
                    <label for="desde" class="form-label small mb-1">Desde</label>
                    <input type="date" id="desde" name="desde" class="form-control form-control-sm"
                           value="@Model.Filtro.Desde?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <label for="hasta" class="form-label small mb-1">Hasta</label>
                    <input type="date" id="hasta" name="hasta" class="form-control form-control-sm"
                           value="@Model.Filtro.Hasta?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <label for="usuario" class="form-label small mb-1">@Model.EtiquetaUsuario</label>
                    <input type="text" id="usuario" name="usuario" maxlength="100" class="form-control form-control-sm"
                           value="@Model.Filtro.Usuario" placeholder="Buscar por nombre" />
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <label for="accion" class="form-label small mb-1">@Model.EtiquetaAccion</label>
                    <select id="accion" name="accion" class="form-select form-select-sm">
                        <option value="">Todas</option>
                        @foreach (var a in Model.Acciones)
                        {
                            <option value="@a" selected="@(string.Equals(a, Model.Filtro.Accion, StringComparison.OrdinalIgnoreCase))">@a</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6 col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm flex-fill">Filtrar</button>
                    <a class="btn btn-outline-primary btn-sm flex-fill" asp-action="Index" asp-route-tipo="@Model.Tipo">Limpiar</a>
                </div>
            </div>
        </form>

        <div class="card-header d-flex justify-content-between">
            <span>Bitácora de @BitacoraIndexViewModel.NombreBitacora(Model.Tipo).ToLower()</span>
            @if (Model.Error is null && Model.AvisoFiltro is null)
            {
                <span class="text-muted small">@(Model.Total == 0 ? "0 registros" : $"Mostrando {Model.PrimerRegistro}–{Model.UltimoRegistro} de {Model.Total} registros")</span>
            }
        </div>

        <div class="card-body">
            @if (Model.Error is not null)
            {
                <div class="alert alert-danger mb-0" role="alert">@Model.Error</div>
            }
            else if (Model.AvisoFiltro is not null)
            {
                <div class="alert alert-warning mb-0" role="alert">@Model.AvisoFiltro</div>
            }
            else if (Model.Registros.Count == 0)
            {
                <div class="alert alert-info mb-0" role="status">
                    @(Model.HayFiltros
                        ? "No hay registros que coincidan con los filtros aplicados."
                        : $"No hay registros en la bitácora de {BitacoraIndexViewModel.NombreBitacora(Model.Tipo).ToLower()}.")
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle small mb-0">
                        <thead>
                            @switch (Model.Tipo)
                            {
                                case TipoBitacora.Accesos:
                                    <tr>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("fecha") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("fecha")'>Fecha y hora <span class="bitacora-flecha">@Model.Flecha("fecha")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("usuario") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("usuario")'>Usuario <span class="bitacora-flecha">@Model.Flecha("usuario")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("ip") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("ip")'>Dirección IP <span class="bitacora-flecha">@Model.Flecha("ip")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("accion") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("accion")'>Acción <span class="bitacora-flecha">@Model.Flecha("accion")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("resultado") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("resultado")'>Resultado <span class="bitacora-flecha">@Model.Flecha("resultado")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("descripcion") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("descripcion")'>Descripción <span class="bitacora-flecha">@Model.Flecha("descripcion")</span></a></th>
                                    </tr>
                                    break;
                                case TipoBitacora.Auditoria:
                                    <tr>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("fecha") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("fecha")'>Fecha y hora <span class="bitacora-flecha">@Model.Flecha("fecha")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("accion") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("accion")'>Acción <span class="bitacora-flecha">@Model.Flecha("accion")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("tabla") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("tabla")'>Tabla <span class="bitacora-flecha">@Model.Flecha("tabla")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("registro") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("registro")'>Registro <span class="bitacora-flecha">@Model.Flecha("registro")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("usuario") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("usuario")'>Usuario <span class="bitacora-flecha">@Model.Flecha("usuario")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("objeto") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("objeto")'>Origen <span class="bitacora-flecha">@Model.Flecha("objeto")</span></a></th>
                                        <th scope="col">Detalles</th>
                                    </tr>
                                    break;
                                case TipoBitacora.Errores:
                                    <tr>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("fecha") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("fecha")'>Fecha y hora <span class="bitacora-flecha">@Model.Flecha("fecha")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("accion") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("accion")'>Operación <span class="bitacora-flecha">@Model.Flecha("accion")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("objeto") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("objeto")'>Objeto <span class="bitacora-flecha">@Model.Flecha("objeto")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("descripcion") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("descripcion")'>Mensaje <span class="bitacora-flecha">@Model.Flecha("descripcion")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("error") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("error")'>N.º error <span class="bitacora-flecha">@Model.Flecha("error")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("severidad") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("severidad")'>Severidad <span class="bitacora-flecha">@Model.Flecha("severidad")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("linea") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("linea")'>Línea <span class="bitacora-flecha">@Model.Flecha("linea")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("usuario") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("usuario")'>Usuario <span class="bitacora-flecha">@Model.Flecha("usuario")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("resultado") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("resultado")'>Resultado <span class="bitacora-flecha">@Model.Flecha("resultado")</span></a></th>
                                    </tr>
                                    break;
                                case TipoBitacora.Notificaciones:
                                    <tr>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("fecha") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("fecha")'>Fecha y hora <span class="bitacora-flecha">@Model.Flecha("fecha")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("paciente") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("paciente")'>Paciente <span class="bitacora-flecha">@Model.Flecha("paciente")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("cita") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("cita")'>Cita <span class="bitacora-flecha">@Model.Flecha("cita")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("descripcion") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("descripcion")'>Mensaje <span class="bitacora-flecha">@Model.Flecha("descripcion")</span></a></th>
                                        <th scope="col" aria-sort="@(Model.EsColumnaOrdenada("resultado") ? (Model.Filtro.Descendente ? "descending" : "ascending") : "none")"><a class="bitacora-orden" asp-action="Index" asp-all-route-data='@Model.RutaOrden("resultado")'>Estado / canal <span class="bitacora-flecha">@Model.Flecha("resultado")</span></a></th>
                                    </tr>
                                    break;
                            }
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Registros)
                            {
                                var fecha = r.FechaHora.ToString("dd/MM/yyyy HH:mm:ss");
                                var usuario = string.IsNullOrWhiteSpace(r.Usuario) ? "Sin registro" : r.Usuario;
                                var resultado = BitacoraIndexViewModel.ClaseResultado(r.Resultado);

                                @switch (Model.Tipo)
                                {
                                    case TipoBitacora.Accesos:
                                        <tr>
                                            <td class="text-nowrap">@fecha</td>
                                            <td>@usuario</td>
                                            <td>@(r.Ip ?? "No disponible")</td>
                                            <td>@r.Accion</td>
                                            <td><span class="badge @resultado">@r.Resultado</span></td>
                                            <td>@r.Descripcion</td>
                                        </tr>
                                        break;
                                    case TipoBitacora.Auditoria:
                                        <tr>
                                            <td class="text-nowrap">@fecha</td>
                                            <td>@r.Accion</td>
                                            <td>@(r.Tabla ?? "No indicada")</td>
                                            <td>@(r.RegistroAfectado ?? "No indicado")</td>
                                            <td>@usuario</td>
                                            <td>@(r.Objeto ?? "No indicado")</td>
                                            <td>
                                                <details>
                                                    <summary>Ver cambios</summary>
                                                    <div class="row g-2 mt-1">
                                                        <div class="col-12 col-lg-6">
                                                            <div class="fw-semibold">Valores anteriores</div>
                                                            <pre class="bitacora-detalle">@BitacoraIndexViewModel.FormatearDetalle(r.ValoresAnteriores)</pre>
                                                        </div>
                                                        <div class="col-12 col-lg-6">
                                                            <div class="fw-semibold">Valores nuevos</div>
                                                            <pre class="bitacora-detalle">@BitacoraIndexViewModel.FormatearDetalle(r.ValoresNuevos)</pre>
                                                        </div>
                                                    </div>
                                                </details>
                                            </td>
                                        </tr>
                                        break;
                                    case TipoBitacora.Errores:
                                        <tr>
                                            <td class="text-nowrap">@fecha</td>
                                            <td>@r.Accion</td>
                                            <td>@(r.Objeto ?? "No indicado")</td>
                                            <td>@r.Descripcion</td>
                                            <td>@(r.NumeroError?.ToString() ?? "—")</td>
                                            <td>@(r.Severidad?.ToString() ?? "—")</td>
                                            <td>@(r.Linea?.ToString() ?? "—")</td>
                                            <td>@usuario</td>
                                            <td><span class="badge @resultado">@r.Resultado</span></td>
                                        </tr>
                                        break;
                                    case TipoBitacora.Notificaciones:
                                        <tr>
                                            <td class="text-nowrap">@fecha</td>
                                            <td>@(r.PacienteId is null ? "Sin paciente" : $"{r.Paciente} (Id {r.PacienteId})")</td>
                                            <td>@(r.CitaId?.ToString() ?? "Sin cita")</td>
                                            <td>@r.Descripcion</td>
                                            <td><span class="badge @resultado">@r.Resultado</span></td>
                                        </tr>
                                        break;
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPaginas > 1)
                {
                    <nav class="mt-3" aria-label="Páginas de la bitácora">
                        <ul class="pagination pagination-sm justify-content-center flex-wrap mb-0 bitacoras-paginacion">
                            <li class="page-item @(Model.Filtro.Pagina == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-all-route-data='@Model.RutaPagina(Model.Filtro.Pagina - 1)'>Anterior</a>
                            </li>
                            @foreach (var p in Model.PaginasVisibles())
                            {
                                if (p is null)
                                {
                                    <li class="page-item disabled"><span class="page-link">…</span></li>
                                }
                                else
                                {
                                    <li class="page-item @(p == Model.Filtro.Pagina ? "active" : "")">
                                        <a class="page-link" asp-action="Index" asp-all-route-data='@Model.RutaPagina(p.Value)'
                                           aria-current="@(p == Model.Filtro.Pagina ? "page" : null)">@p</a>
                                    </li>
                                }
                            }
                            <li class="page-item @(Model.Filtro.Pagina == Model.TotalPaginas ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-all-route-data='@Model.RutaPagina(Model.Filtro.Pagina + 1)'>Siguiente</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
