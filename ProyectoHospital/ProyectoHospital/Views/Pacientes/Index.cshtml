@model List<ProyectoHospital.Models.Entities.Paciente>

@{
    ViewData["Title"] = "Gestión de pacientes";
}

<div class="container mt-4">

    <h2>Gestión de pacientes</h2>

    <p class="text-muted">
        Pacientes registrados en el Sistema Hospitalario.
    </p>

    @* HU09 - T03:
   Acceso al formulario de registro de pacientes. *@

    <div class="mb-3">
        <a asp-controller="Pacientes"
           asp-action="Create"
           class="btn btn-primary">

            Registrar nuevo paciente

        </a>
    </div>

    @* Mostrar el mensaje después de registrar. *@
    @if (TempData["MensajeExito"] is string mensaje)
    {
        <div class="alert alert-success" role="alert">
            @mensaje
        </div>
    }

    <div class="table-responsive">

        <table class="table table-striped table-hover">

            <thead>
                <tr>
                    <th>Identificación</th>
                    <th>Nombre completo</th>
                    <th>Fecha de nacimiento</th>
                    <th>Teléfono</th>
                    <th>Estado</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var paciente in Model)
                {
                    <tr>
                        <td>@paciente.NumeroIdentificacion</td>

                        <td>
                            @paciente.Nombre @paciente.Apellidos
                        </td>

                        <td>
                            @paciente.FechaNacimiento.ToString("dd/MM/yyyy")
                        </td>

                        <td>@paciente.NumeroTelefono</td>

                        <td>
                            @(paciente.Activo ? "Activo" : "Inactivo")
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>