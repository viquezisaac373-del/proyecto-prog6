@model ProyectoHospital.Models.ViewModels.PacienteFormViewModel

@{
    ViewData["Title"] = "Registrar paciente";
}

@* HU09 - T03
   Biblioteca para seleccionar países y validar teléfonos internacionales. *@
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/intl-tel-input@29.5.8/dist/css/intlTelInput.min.css" />

<style>
    /* Mantener los teléfonos adaptados al ancho del formulario. */
    .iti {
        width: 100%;
    }

        .iti .form-control {
            width: 100%;
        }

    /* Permitir que las listas de países se visualicen correctamente. */
    .iti__country-list {
        max-width: min(350px, 90vw);
    }
</style>

<div class="container mt-4 mb-5">

    <div class="mb-4">
        <h2>Registrar paciente</h2>

        <p class="text-muted">
            Complete la información para registrar
            un nuevo paciente en el Sistema Hospitalario.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <form id="formRegistroPaciente"
                  asp-controller="Pacientes"
                  asp-action="Create"
                  method="post">

                @* Protección contra solicitudes CSRF. *@
                @Html.AntiForgeryToken()

                @* Errores generales enviados por el controlador. *@
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div id="mensajeTelefonos"
                     class="alert alert-warning d-none"
                     role="alert"></div>

                @* ============================== *@
                @* INFORMACIÓN PERSONAL           *@
                @* ============================== *@

                <h5 class="mb-3">
                    Información personal
                </h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="NumeroIdentificacion"
                               class="form-label">
                            Identificación
                        </label>

                        <input asp-for="NumeroIdentificacion"
                               class="form-control"
                               inputmode="numeric"
                               maxlength="25" />

                        <span asp-validation-for="NumeroIdentificacion"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FechaNacimiento"
                               class="form-label">
                            Fecha de nacimiento
                        </label>

                        @* Impide seleccionar fechas futuras en el navegador.
                           El servidor también valida esta restricción. *@
                        <input asp-for="FechaNacimiento"
                               type="date"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")"
                               class="form-control" />

                        <span asp-validation-for="FechaNacimiento"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Nombre"
                               class="form-label">
                            Nombre
                        </label>

                        <input asp-for="Nombre"
                               class="form-control"
                               maxlength="100" />

                        <span asp-validation-for="Nombre"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Apellidos"
                               class="form-label">
                            Apellidos
                        </label>

                        <input asp-for="Apellidos"
                               class="form-control"
                               maxlength="130" />

                        <span asp-validation-for="Apellidos"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Genero"
                               class="form-label">
                            Género
                        </label>

                        <select asp-for="Genero"
                                class="form-select">

                            <option value="">
                                Seleccione...
                            </option>

                            <option value="Masculino">
                                Masculino
                            </option>

                            <option value="Femenino">
                                Femenino
                            </option>

                            <option value="Otro">
                                Otro
                            </option>

                        </select>

                        <span asp-validation-for="Genero"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TipoSangre"
                               class="form-label">
                            Tipo de sangre
                        </label>

                        <select asp-for="TipoSangre"
                                class="form-select">

                            <option value="">
                                Seleccione...
                            </option>

                            <option value="ND">
                                No determinado
                            </option>

                            <option value="O+">O+</option>
                            <option value="O-">O-</option>
                            <option value="A+">A+</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="B-">B-</option>
                            <option value="AB+">AB+</option>
                            <option value="AB-">AB-</option>

                        </select>

                        <span asp-validation-for="TipoSangre"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                @* ============================== *@
                @* INFORMACIÓN DE CONTACTO        *@
                @* ============================== *@

                <h5 class="mb-3">
                    Información de contacto
                </h5>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label for="telefonoVisible"
                               class="form-label">
                            Teléfono
                        </label>

                        @* Campo visual: muestra bandera y prefijo.
                           No se envía directamente al controlador. *@
                        <input id="telefonoVisible"
                               type="tel"
                               class="form-control"
                               autocomplete="tel"
                               inputmode="tel"
                               value="@Model.NumeroTelefono"
                               required
                               aria-describedby="errorTelefono" />

                        @* Campo enviado al servidor en formato internacional.
                           Ejemplo: +50685102283 *@
                        <input asp-for="NumeroTelefono"
                               type="hidden" />

                        <div id="errorTelefono"
                             class="text-danger small mt-1"
                             aria-live="polite"></div>

                        <span asp-validation-for="NumeroTelefono"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Correo"
                               class="form-label">
                            Correo electrónico
                        </label>

                        <input asp-for="Correo"
                               type="email"
                               class="form-control"
                               maxlength="200" />

                        <span asp-validation-for="Correo"
                              class="text-danger"></span>

                    </div>

                    <div class="col-12">

                        <label asp-for="Direccion"
                               class="form-label">
                            Dirección
                        </label>

                        <textarea asp-for="Direccion"
                                  class="form-control"
                                  rows="2"
                                  maxlength="250"></textarea>

                        <span asp-validation-for="Direccion"
                              class="text-danger"></span>

                    </div>

                </div>

                <hr class="my-4" />

                @* ============================== *@
                @* CONTACTO DE EMERGENCIA          *@
                @* ============================== *@

                <h5 class="mb-3">
                    Contacto de emergencia
                </h5>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="ContactoEmergencia"
                               class="form-label">
                            Nombre del contacto
                        </label>

                        <input asp-for="ContactoEmergencia"
                               class="form-control"
                               maxlength="100" />

                        <span asp-validation-for="ContactoEmergencia"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label for="emergenciaVisible"
                               class="form-label">
                            Teléfono de emergencia
                        </label>

                        @* Segundo selector internacional independiente. *@
                        <input id="emergenciaVisible"
                               type="tel"
                               class="form-control"
                               inputmode="tel"
                               value="@Model.TelefonoEmergencia"
                               required
                               aria-describedby="errorEmergencia" />

                        @* Valor completo enviado al controlador. *@
                        <input asp-for="TelefonoEmergencia"
                               type="hidden" />

                        <div id="errorEmergencia"
                             class="text-danger small mt-1"
                             aria-live="polite"></div>

                        <span asp-validation-for="TelefonoEmergencia"
                              class="text-danger"></span>

                    </div>

                </div>

                <hr class="my-4" />

                @* ============================== *@
                @* BOTONES                         *@
                @* ============================== *@

                <div class="d-flex flex-wrap gap-2 justify-content-end">

                    <a asp-controller="Pacientes"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button id="btnRegistrar"
                            type="submit"
                            class="btn btn-primary"
                            disabled>
                        Registrar paciente
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {

    @* Scripts de validación propios de ASP.NET Core MVC. *@
    <partial name="_ValidationScriptsPartial" />

    @* Biblioteca internacional de teléfonos. *@
    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@29.5.8/dist/js/intlTelInput.min.js"></script>

    <script>
        // HU09 - T03
        // Configurar los dos selectores telefónicos.
        // Se almacenarán en formato E.164 antes de enviar el formulario.

        const formulario = document.getElementById("formRegistroPaciente");

        const telefonoVisible = document.getElementById("telefonoVisible");
        const emergenciaVisible = document.getElementById("emergenciaVisible");

        const telefonoCompleto = document.getElementById("NumeroTelefono");
        const emergenciaCompleto = document.getElementById("TelefonoEmergencia");

        const errorTelefono = document.getElementById("errorTelefono");
        const errorEmergencia = document.getElementById("errorEmergencia");

        const botonRegistrar = document.getElementById("btnRegistrar");
        const mensajeTelefonos = document.getElementById("mensajeTelefonos");

        let telefonosListos = false;

        // Mostrar errores de inicialización.
        function mostrarErrorGeneral(mensaje) {
            mensajeTelefonos.textContent = mensaje;
            mensajeTelefonos.classList.remove("d-none");
        }

        // Configuración compartida para ambos teléfonos.
        function inicializarTelefono(campo) {

            return window.intlTelInput(campo, {

                // Costa Rica es el país inicial.
                initialCountry: "cr",

                // Países que aparecerán al principio del listado.
                countryOrder: ["cr", "ni", "pa", "us", "mx", "co", "es"],

                // Mostrar bandera y prefijo por separado.
                separateDialCode: true,
                showFlags: true,

                // Permitir buscar países.
                countrySearch: true,
                countryNameLocale: "es",

                // Limitar el ingreso a caracteres telefónicos.
                strictMode: true,

                // Cargar las funciones de formato y validación.
                loadUtils: () => import(
                    "https://cdn.jsdelivr.net/npm/intl-tel-input@29.5.8/dist/js/utils.js"
                )
            });
        }

        let selectorTelefono;
        let selectorEmergencia;

        if (!window.intlTelInput) {

            mostrarErrorGeneral(
                "No se pudo cargar el selector de países. Revise la conexión a Internet."
            );

        } else {

            selectorTelefono = inicializarTelefono(telefonoVisible);
            selectorEmergencia = inicializarTelefono(emergenciaVisible);

            // Esperar a que se carguen los recursos de validación.
            Promise.all([
                selectorTelefono.promise,
                selectorEmergencia.promise
            ])
            .then(() => {

                telefonosListos = true;
                botonRegistrar.disabled = false;

            })
            .catch(() => {

                mostrarErrorGeneral(
                    "No se pudo cargar la validación telefónica. Recargue la página."
                );

            });
        }

        // Quitar el error visual cuando el usuario modifica un teléfono.
        function limpiarError(campo, contenedorError) {

            campo.setCustomValidity("");
            contenedorError.textContent = "";

        }

        telefonoVisible.addEventListener("input", () => {
            limpiarError(telefonoVisible, errorTelefono);
        });

        emergenciaVisible.addEventListener("input", () => {
            limpiarError(emergenciaVisible, errorEmergencia);
        });

        telefonoVisible.addEventListener("countrychange", () => {
            limpiarError(telefonoVisible, errorTelefono);
        });

        emergenciaVisible.addEventListener("countrychange", () => {
            limpiarError(emergenciaVisible, errorEmergencia);
        });

        // Validar un número con las reglas del país seleccionado.
        function validarTelefono(campo, selector, contenedorError) {

            limpiarError(campo, contenedorError);

            if (!campo.value.trim() || !selector.isValidNumber()) {

                const mensaje =
                    "Ingrese un número válido para el país seleccionado.";

                campo.setCustomValidity(mensaje);
                contenedorError.textContent = mensaje;
                campo.reportValidity();

                return false;
            }

            return true;
        }

        // Se ejecuta antes del envío normal del formulario MVC.
        formulario.addEventListener("submit", function (evento) {

            // No enviar números sin la validación internacional.
            if (!telefonosListos) {

                evento.preventDefault();
                evento.stopImmediatePropagation();

                mostrarErrorGeneral(
                    "La validación telefónica todavía no está disponible."
                );

                return;
            }

            const principalValido = validarTelefono(
                telefonoVisible,
                selectorTelefono,
                errorTelefono
            );

            if (!principalValido) {

                evento.preventDefault();
                evento.stopImmediatePropagation();

                telefonoVisible.focus();
                return;
            }

            const emergenciaValido = validarTelefono(
                emergenciaVisible,
                selectorEmergencia,
                errorEmergencia
            );

            if (!emergenciaValido) {

                evento.preventDefault();
                evento.stopImmediatePropagation();

                emergenciaVisible.focus();
                return;
            }

            // Obtener el número completo en formato E.164.
            // Ejemplo: +50685102283
            //
            // Estos valores son los que recibirá el ViewModel.
            telefonoCompleto.value = selectorTelefono.getNumber();
            emergenciaCompleto.value = selectorEmergencia.getNumber();

        }, true);

    </script>
}
