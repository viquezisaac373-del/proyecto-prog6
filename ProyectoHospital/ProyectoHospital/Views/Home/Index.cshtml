@{
    ViewData["Title"] = "Inicio";
}

<div class="container my-4 mb-5">
    @* Inicio informativo: no es el listado de módulos operativos. *@
    <section class="p-4 p-md-5 rounded border bg-white mb-4">
        <div class="row align-items-center g-4">
            <div class="col-md-8">
                <p class="text-uppercase small fw-semibold text-muted mb-2">
                    Sistema hospitalario
                </p>
                <h1 class="mb-3">Bienvenido a Hospinomenal</h1>
                <p class="lead mb-2">Innovación y cuidado en cada atención</p>
                <p>
                    Un espacio de trabajo para organizar los procesos administrativos
                    de un hospital y acceder a los módulos habilitados según el
                    perfil de cada usuario.
                </p>
                <a asp-controller="Modulos"
                   asp-action="Index"
                   class="btn btn-primary mt-2">
                    Ir al panel de módulos
                </a>
            </div>
            <div class="col-md-4 text-center">
                <img src="~/images/favicon.svg"
                     class="hospital-logo"
                     alt="Símbolo de Hospinomenal" />
            </div>
        </div>
    </section>

    <section aria-labelledby="tituloInformacion" class="mb-4">
        <h2 id="tituloInformacion" class="h4 mb-3">Información general</h2>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="h-100 border rounded bg-white p-3">
                    <h3 class="h5">Acceso autorizado</h3>
                    <p class="mb-0">
                        Cada usuario accede mediante una sesión individual.
                        Los permisos dependen de los roles asignados.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="h-100 border rounded bg-white p-3">
                    <h3 class="h5">Gestión de pacientes</h3>
                    <p class="mb-0">
                        El mantenimiento de pacientes permite consultar,
                        registrar, modificar y desactivar registros.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="h-100 border rounded bg-white p-3">
                    <h3 class="h5">Evolución del sistema</h3>
                    <p class="mb-0">
                        Las secciones de citas y medicamentos se incorporarán
                        cuando sus módulos estén integrados y validados.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="border rounded bg-white p-3 p-md-4 mb-4"
             aria-labelledby="tituloAccesos">
        <h2 class="h4" id="tituloAccesos">Accesos disponibles</h2>
        <p>
            Utilice el panel de módulos para entrar a las funcionalidades del sistema.
            La gestión de pacientes requiere permisos de administrador en esta etapa.
        </p>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="Modulos"
               asp-action="Index"
               class="btn btn-outline-primary">
                Ver módulos
            </a>
            @if (User.IsInRole("Administrador"))
            {
                <a asp-controller="Pacientes"
                   asp-action="Index"
                   class="btn btn-primary">
                    Gestionar pacientes
                </a>
            }
        </div>
    </section>

    <section id="contacto" class="mb-4" aria-labelledby="tituloContacto">
        <h2 id="tituloContacto" class="h4">Información y soporte</h2>
        <p>
            Para consultas operativas o problemas de acceso, comuníquese
            con el responsable designado por el hospital.
        </p>
        <p class="text-muted small mb-0">
            El formulario de contacto y los canales de soporte se definirán
            en una etapa posterior. No se han configurado destinatarios.
        </p>
    </section>
</div>
