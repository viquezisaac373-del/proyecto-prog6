@{
    ViewData["Title"] = "Inicio";
}

<div class="container my-4 mb-5">
    @if (User.IsInRole("Cliente"))
    {
        <section class="p-4 p-md-5 rounded border bg-white mb-4">
            <div class="row align-items-center g-4">
                <div class="col-md-8">
                    <p class="text-uppercase small fw-semibold text-muted mb-2">
                        Portal de clientes
                    </p>
                    <h1 class="mb-3">Bienvenido a Hospinomenal</h1>
                    <p class="lead">Tu espacio de consulta</p>
                    <p>
                        Consultá los datos de tu cuenta y explorá los productos publicados
                        en el catálogo del hospital.
                    </p>
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-controller="CuentaCliente" asp-action="MiCuenta"
                           class="btn btn-primary">Mi cuenta</a>
                        <a asp-controller="CuentaCliente" asp-action="Catalogo"
                           class="btn btn-outline-primary">Ver catálogo</a>
                    </div>
                </div>
                <div class="col-md-4 text-center">
                    <img src="~/images/logo.jpeg" class="hospital-logo"
                         alt="Símbolo de Hospinomenal" />
                </div>
            </div>
        </section>
        <section aria-labelledby="serviciosCliente" class="mb-4">
            <h2 id="serviciosCliente" class="h4 mb-3">Opciones disponibles para clientes</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="h-100 border rounded bg-white p-3">
                        <h3 class="h5">Mis datos</h3>
                        <p>Revisá tu nombre, identificación y cuenta de acceso.</p>
                        <a asp-controller="CuentaCliente" asp-action="MiCuenta">Consultar mi cuenta</a>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="h-100 border rounded bg-white p-3">
                        <h3 class="h5">Productos</h3>
                        <p>Consultá artículos activos y vendibles, con precios de referencia.</p>
                        <a asp-controller="CuentaCliente" asp-action="Catalogo">Explorar catálogo</a>
                    </div>
                </div>
            </div>
        </section>
        <div class="alert alert-info" role="note">
            Las compras, los pagos, las facturas electrónicas y la solicitud de citas en línea
            todavía no están disponibles en este portal.
        </div>
    }
    else
    {
    @* Inicio informativo para personal: no es el listado de módulos operativos. *@
    <section class="p-4 p-md-5 rounded border bg-white mb-4">
        <div class="row align-items-center g-4">
            <div class="col-md-8">
                <p class="text-uppercase small fw-semibold text-muted mb-2">
                    Sistema hospitalario
                </p>
                <h1 class="mb-3">Bienvenido a Hospinomenal</h1>
                <p class="lead mb-2">Innovación y cuidado en cada atención</p>
                <p>
                    Un espacio de trabajo para organizar los procesos administrativos
                    de un hospital y acceder a los módulos habilitados según el
                    perfil de cada usuario.
                </p>
                @if (User.IsInRole("Cliente"))
                {
                    <a asp-controller="CuentaCliente" asp-action="MiCuenta"
                       class="btn btn-primary mt-2">Ir a mi cuenta</a>
                }
                else
                {
                    <a asp-controller="Modulos" asp-action="Index"
                       class="btn btn-primary mt-2">Ir al panel de módulos</a>
                }
            </div>
            <div class="col-md-4 text-center">
                <img src="~/images/logo.jpeg"
                     class="hospital-logo"
                     alt="Símbolo de Hospinomenal" />
            </div>
        </div>
    </section>

    <section aria-labelledby="tituloInformacion" class="mb-4">
        <h2 id="tituloInformacion" class="h4 mb-3">Información general</h2>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="h-100 border rounded bg-white p-3">
                    <h3 class="h5">Acceso autorizado</h3>
                    <p class="mb-0">
                        Cada usuario accede mediante una sesión individual.
                        Los permisos dependen de los roles asignados.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="h-100 border rounded bg-white p-3">
                    <h3 class="h5">Gestión de pacientes</h3>
                    <p class="mb-0">
                        El mantenimiento de pacientes permite consultar,
                        registrar, modificar y desactivar registros.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="h-100 border rounded bg-white p-3">
                    <h3 class="h5">Evolución del sistema</h3>
                    <p class="mb-0">
                        Las secciones de citas y medicamentos se incorporarán
                        cuando sus módulos estén integrados y validados.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="border rounded bg-white p-3 p-md-4 mb-4"
             aria-labelledby="tituloAccesos">
        <h2 class="h4" id="tituloAccesos">Accesos disponibles</h2>
        <p>
            Utilice el panel de módulos para entrar a las funcionalidades del sistema.
            La gestión de pacientes requiere permisos de administrador en esta etapa.
        </p>
        <div class="d-flex gap-2 flex-wrap">
            @if (!User.IsInRole("Cliente"))
            {
                <a asp-controller="Modulos" asp-action="Index"
                   class="btn btn-outline-primary">Ver módulos</a>
            }
            else
            {
                <a asp-controller="CuentaCliente" asp-action="Catalogo"
                   class="btn btn-outline-primary">Ver catálogo de productos</a>
            }
            @if (User.IsInRole("Administrador"))
            {
                <a asp-controller="Pacientes"
                   asp-action="Index"
                   class="btn btn-primary">
                    Gestionar pacientes
                </a>
            }
        </div>
    </section>

    <section id="contacto" class="mb-4" aria-labelledby="tituloContacto">
        <h2 id="tituloContacto" class="h4">Información y soporte</h2>
        <p>
            Para consultas operativas o problemas de acceso, comuníquese
            con el responsable designado por el hospital.
        </p>
        <p class="text-muted small mb-0">
            El formulario de contacto y los canales de soporte se definirán
            en una etapa posterior. No se han configurado destinatarios.
        </p>
    </section>
    }
</div>
