@model HomeViewModel

@{
    ViewData["Title"] = "Inicio";
}
@section Scripts {
    <script src="~/js/FormularioContacto.js" asp-append-version="true"></script>
}

<div>
    <section class="text-center py-4">
        <img src="~/images/favicon.svg" 
             alt="Logo de la web principal"
             class="hospital-logo mb-3" />



        <h1>Hospinomenal</h1>

        <p>
            "Innovacion y Cuidado en cada atencion"
        </p>

        <a class="btn btn-primary" href="#servicios">
            Ver servicios
        </a>
    </section>

    <section id="servicios">
        <h2>Servicios principales</h2>

        <p>
            Seleccione una de las siguientes opciones:
        </p>

        <div class="row">
            @foreach (ServicioHospitalario servicio in Model.Servicios)
            {
                <div class="col-md-4 mb-3"
                     id="servicio-@servicio.Id">

                    <div class="border rounded p-3">
                        <h3 class="h5">
                            @servicio.Nombre
                        </h3>

                        <p>
                            @servicio.Descripcion
                        </p>

                        @switch (servicio.TipoServicio)
                        {
                            case tiposerviciohospitalario.Cita:
                                <a class="btn btn-outline-primary"
                                asp-controller="Citas"
                                asp-action="Citas">
                                    Gestionar citas
                                </a>
                                break;
                            case tiposerviciohospitalario.Paciente:
                                <a class="btn btn-outline-primary"
                                asp-controller="Pacientes"
                                asp-action="Pacientes">
                                    Gestionar Pacientes
                                </a>
                                break;
                            case tiposerviciohospitalario.Medicamento:
                                <a class="btn btn-outline-primary"
                                asp-controller="Medicamentos"
                                asp-action="Medicamentos">
                                    Gestionar Medicamentos
                                </a>
                                break;
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    <hr />

    <section id="contacto" class="mb-4">
        <h2>Contacto</h2>

        <p>
            Para más información, comuníquese con la recepción.
        </p>

        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalContacto">
            Contactar
        </button>
    </section>

    <div class="modal" id="modalContacto" tabindex="-1" aria-labelledby="labelModalContacto" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="labelModalContacto">Formulario de contacto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="mb-3">
                            <label for="nombre" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="nombre" placeholder="Ingrese su nombre">
                        </div>
                        <div class="mb-3">
                            <label for="apellido" class="form-label">Apellido</label>
                            <input type="text" class="form-control" id="apellido" placeholder="Ingrese su apellido">
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Correo electrónico</label>
                            <input type="email" class="form-control" id="email" placeholder="Ingrese su correo electrónico">
                        </div>
                        <div class="mb-3">
                            <label for="mensaje" class="form-label">Mensaje</label>
                            <textarea class="form-control" id="mensaje" rows="3" placeholder="Ingrese su mensaje"></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="button" class("btn btn-primary">Enviar</button>
                </div>
            </div>
        </div>
    </div>








