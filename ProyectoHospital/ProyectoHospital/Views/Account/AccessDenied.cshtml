@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="alert alert-danger shadow-sm" role="alert">
            <h1 class="h4 alert-heading">Acceso denegado</h1>
            <p class="mb-0">No tiene permisos para acceder a esta página.</p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <hr />
                <p class="mb-0">Usuario: <strong>@User.Identity.Name</strong></p>
            }
        </div>

        <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
    </div>
</div>
