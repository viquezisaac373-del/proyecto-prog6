@model List<ProductoCatalogo>
@{
    ViewData["Title"] = "Catálogo de productos";
}
<div class="container my-4">
    <h1 class="h3">Catálogo de productos</h1>
    <p class="text-muted">Artículos marcados como vendibles y activos en el inventario del hospital.</p>
    <div class="alert alert-warning">
        Catálogo informativo: no confirma existencias disponibles ni admite pagos o compras todavía.
    </div>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead><tr><th>Producto</th><th>Descripción</th><th class="text-end">Precio de referencia</th></tr></thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Descripcion) ? "—" : item.Descripcion)</td>
                        <td class="text-end">₡@item.PrecioVenta.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0)
    {
        <p>No hay productos disponibles en este catálogo de consulta.</p>
    }
    <a asp-action="MiCuenta" class="btn btn-outline-secondary">Volver a mi cuenta</a>
</div>
