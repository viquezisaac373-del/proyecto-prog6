@model HomeViewModel

@{
    ViewData["Title"] = "Panel de módulos";
}

<div class="container my-4 mb-5">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h2">Panel de módulos</h1>
            <p class="text-muted">
                Seleccione la sección con la que desea trabajar.
                Algunas funcionalidades siguen en desarrollo.
            </p>
        </div>
        <a asp-controller="Home" asp-action="Index"
           class="btn btn-outline-secondary">
            Volver al inicio
        </a>
    </div>

    <div class="row g-3">
        @foreach (ServicioHospitalario servicio in Model.Servicios)
        {
            <div class="col-md-4" id="servicio-@servicio.Id">
                <div class="border rounded bg-white p-4 h-100 d-flex flex-column">
                    <h2 class="h5">@servicio.Nombre</h2>
                    <p>@servicio.Descripcion</p>
                    <div class="mt-auto">
                        @switch (servicio.TipoServicio)
                        {
                            case TipoServicioHospitalario.Pacientes:
                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-controller="Pacientes"
                                       asp-action="Index"
                                       class="btn btn-primary">
                                        Gestionar pacientes
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        Acceso restringido por rol
                                    </span>
                                }
                                break;
                            case TipoServicioHospitalario.Citas:
                                <a asp-controller="Citas"
                                   asp-action="Index"
                                   class="btn btn-outline-primary">
                                    Ver sección de citas
                                </a>
                                break;
                            case TipoServicioHospitalario.Medicamentos:
                                <a asp-controller="Medicamentos"
                                   asp-action="Index"
                                   class="btn btn-outline-primary">
                                    Ver sección de medicamentos
                                </a>
                                break;
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
